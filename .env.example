# Development defaults only. Do not copy production secrets into this file.
# Leave NODE_ENV unset locally; set NODE_ENV=production in the host environment.
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/masaloo
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
CLIENT_ORIGIN=http://127.0.0.1:5173
# Blank uses ./uploads during development. Production requires an absolute mounted directory.
UPLOAD_DIR=
# No proxy mode, proxy address list, or header-verification variables are needed.
# Hosting/build settings (host environment, not required for development):
# RAILPACK_NODE_VERSION=<reviewed Node 22 patch, at least 22.12>
# RAILPACK_NODE_NPM_INSTALL=npm ci --include=dev
# RAILPACK_NO_SPA=true
# RAILWAY_DEPLOYMENT_DRAINING_SECONDS=30
# Used only by npm run seed:admin; never exposed in the browser.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
