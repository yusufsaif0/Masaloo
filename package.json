{
  "name": "masaloo-store",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0 <23" },
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,green \"node --watch server/index.js\" \"vite --host 127.0.0.1\"",
    "build": "vite build",
    "start": "node server/index.js",
    "seed:admin": "node server/seed-admin.js",
    "test": "node --test server/tests/*.test.js",
    "test:browser": "node scripts/check-browser.mjs",
    "test:admin": "node scripts/check-admin-browser.mjs",
    "test:finance": "node scripts/check-finance-browser.mjs",
    "test:wholesale": "node scripts/check-wholesale-browser.mjs",
    "test:production": "node scripts/check-production.mjs",
    "scrape:wholesale": "node scripts/scrape-wholesale.mjs",
    "setup:local": "node scripts/prepare-local.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.468.0",
    "mongoose": "^8.19.0",
    "multer": "^2.0.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.1",
    "sharp": "^0.35.5",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "vite": "^7.1.7"
  }
}
